{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neon-futsal-online",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBY",
        "class_name": "Lobby"
      },
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby", "GameRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
